<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tmdb_dark_blue"
    tools:context=".ui.main.homefragment.HomeFragment">

    <!-- ===== HEADER =====
         Background gradient memanjang sampai belakang status bar (edge-to-edge).
         Saat scroll ke bawah judul tersembunyi, hanya search bar yang tetap menempel. -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <!-- Judul: bergerak ke atas mengikuti jari (tanpa snap) sambil memudar -->
        <LinearLayout
            android:id="@+id/layout_greeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="4dp"
            app:layout_scrollFlags="scroll">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_greeting_title"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/home_greeting_subtitle"
                android:textColor="@color/tmdb_light_blue"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Search bar berbentuk pill (tetap menempel di atas) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_search"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/tmdb_dark_blue"
            app:cardCornerRadius="26dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/tmdb_light_blue"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="4dp">

                <!-- Ikon kaca pembesar / loading kecil di posisi yang sama -->
                <FrameLayout
                    android:layout_width="22dp"
                    android:layout_height="22dp">

                    <ImageView
                        android:id="@+id/iv_search_icon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/search_icon_desc"
                        android:src="@drawable/ic_search"
                        app:tint="@color/tmdb_light_blue" />

                    <ProgressBar
                        android:id="@+id/progress_search"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminateTint="@color/tmdb_light_blue"
                        android:visibility="gone" />
                </FrameLayout>

                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textColorHint="#8099B4C8"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/btn_clear_search"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/search_clear_desc"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="@color/tmdb_light_blue"
                    tools:visibility="visible" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ===== KONTEN ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Grid film (item pertama = judul section) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_movies"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="8dp"
            android:paddingBottom="8dp"
            tools:listitem="@layout/item_movie" />

        <!-- Progress Bar halaman pertama (di tengah) -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/tmdb_light_blue"
            android:visibility="gone" />

        <!-- Progress Bar halaman berikutnya (kecil, di bawah) -->
        <ProgressBar
            android:id="@+id/progress_load_more"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:indeterminateTint="@color/tmdb_light_blue"
            android:visibility="gone" />

        <!-- Layout error penuh (halaman pertama gagal dimuat) -->
        <LinearLayout
            android:id="@+id/layout_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="32dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_error_title"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_error_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/tmdb_light_blue"
                android:textSize="14sp"
                tools:text="Tidak ada koneksi internet. Periksa jaringan Anda." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/tmdb_light_blue"
                android:text="@string/action_retry"
                android:textColor="@color/tmdb_dark_blue" />
        </LinearLayout>

        <!-- Empty state (hasil pencarian kosong / tidak ada film) -->
        <LinearLayout
            android:id="@+id/layout_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="32dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:alpha="0.4"
                android:contentDescription="@null"
                android:src="@drawable/ic_search"
                app:tint="@color/tmdb_light_blue" />

            <TextView
                android:id="@+id/tv_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                tools:text="Film &quot;xyz&quot; tidak ditemukan.\nCoba kata kunci lain." />
        </LinearLayout>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>